{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "syllabus_cliente": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "aot": true,
            "allowedCommonJsDependencies": [
              "lodash",
              "assert",
              "moment",
              "sweetalert2"
            ],
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/assets/styles/palette-angular-material.css",
              "src/assets/styles/sga-theme-angular-material.scss",
              "src/assets/styles/sga-form.css",
              "src/assets/styles/sga-global.css",
              "src/assets/styles/sga-text.css",
              "src/assets/styles/layout.scss",
              "src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.production.ts"
                }
              ]
            },
            "development": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            },
            "local": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "outputHashing": "none"
            },
            "single-spa": {
              "main": "src/main.single-spa.ts",
              "tsConfig": "tsconfig.app.single-spa.json",
              "optimization": true,
              "outputHashing": "none",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "buildOptimizer": true,
              "customWebpackConfig": {
                "path": "extra-webpack.config.js",
                "libraryName": "syllabus-mf",
                "libraryTarget": "umd"
              },
              "deployUrl": "https://syllabus.portaloas.udistrital.edu.co/",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.production.ts"
                }
              ]
            },
            "single-spa-development": {
              "main": "src/main.single-spa.ts",
              "tsConfig": "tsconfig.app.single-spa.json",
              "optimization": true,
              "outputHashing": "none",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "buildOptimizer": true,
              "customWebpackConfig": {
                "path": "extra-webpack.config.js",
                "libraryName": "syllabus-mf",
                "libraryTarget": "umd"
              },
              "deployUrl": "https://pruebassyllabus.portaloas.udistrital.edu.co/",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "local"
        },
        "serve": {
          "builder": "@angular-builders/custom-webpack:dev-server",
          "options": {
            "browserTarget": "syllabus_cliente:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "syllabus_cliente:build:production"
            },
            "development": {
              "browserTarget": "syllabus_cliente:build:development"
            },
            "local": {
              "browserTarget": "syllabus_cliente:build:local"
            },
            "single-spa": {
              "browserTarget": "syllabus_cliente:build:single-spa"
            },
            "single-spa-development": {
              "browserTarget": "syllabus_cliente:build:single-spa-development"
            }
          },
          "defaultConfiguration": "local"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "syllabus_cliente:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/assets/styles/palette-angular-material.css",
              "src/assets/styles/sga-theme-angular-material.scss",
              "src/assets/styles/sga-form.css",
              "src/assets/styles/sga-global.css",
              "src/assets/styles/sga-text.css",
              "src/assets/styles/layout.scss",
              "src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
