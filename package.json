{
  "name": "syllabus-cliente",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prepare": "husky",
    "build:prod": "npm run build -- --aot --configuration=production",
    "build:test": "npm run build -- --aot --configuration=test",
    "build:dev": "npm run build -- --aot --configuration=dev",
    "build:single-spa:syllabus-mf": "ng build syllabus_cliente --configuration single-spa",
    "serve:single-spa:syllabus-mf": "ng s --project syllabus_cliente --configuration single-spa --disable-host-check --port 4227 --live-reload false"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.0",
    "@angular/cdk": "~16.2.0",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/material": "~16.2.0",
    "@angular/material-moment-adapter": "^16.2.3",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@sweetalert2/ngx-sweetalert2": "^12.2.0",
    "@sweetalert2/themes": "^5.0.16",
    "moment": "^2.29.4",
    "ngx-mat-select-search": "^7.0.6",
    "rxjs": "~7.8.0",
    "single-spa": ">=4.0.0",
    "single-spa-angular": "^9.0.1",
    "spinner-util": "^0.0.3",
    "sweetalert2": "^11.7.28",
    "ts-md5": "^1.3.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "16.0.1",
    "@angular-devkit/build-angular": "^16.2.0",
    "@angular/cli": "~16.2.0",
    "@angular/compiler-cli": "^16.2.0",
    "@schematics/angular": "^16.2.12",
    "@types/jasmine": "~4.3.0",
    "husky": "^9.0.11",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "simple-git": "^3.24.0",
    "style-loader": "^3.3.1",
    "typescript": "~5.1.3"
  }
}
